<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:70" width="500" height="500" name="Raccoon" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <!-- Contact Shadow -->
        <Shape x="250" y="445" name="Shadow" id="0:10">
            <Ellipse originX="0.5" originY="0.5" width="160" height="26" name="ShadowEllipse"/>
            <Fill name="ShadowFill">
                <SolidColor colorValue="40000000" name="Color"/>
            </Fill>
        </Shape>

        <!-- Solo Container for Mascot Emotional Poses -->
        <Solo x="250" y="270" activeComponentId="0:20" name="MascotSolo" id="0:15">
