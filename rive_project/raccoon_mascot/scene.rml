                    </StateTransition>
                    <StateTransition stateToId="0:34">
                        <TransitionNumberCondition inputId="0:80" opValue="equal" value="4"/>
                    </StateTransition>
                </AnyState>

                <ExitState x="400" y="-120"/>

                <EntryState>
                    <StateTransition stateToId="0:30"/>
                </EntryState>

                <AnimationState x="150" y="0" animationId="0:40" id="0:30"/>
                <AnimationState x="150" y="60" animationId="0:41" id="0:31"/>
                <AnimationState x="150" y="120" animationId="0:42" id="0:32"/>
                <AnimationState x="150" y="180" animationId="0:43" id="0:33"/>
                <AnimationState x="150" y="240" animationId="0:44" id="0:34"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- 0: IDLE Animation (Gentle floating & breathing) -->
        <LinearAnimation loopValue="1" duration="120" name="AnimIdle" id="0:40">
            <KeyedObject objectId="0:15">
