            <Image originX="0.5" originY="0.5" assetId="0:104" name="Celebration" id="0:24"/>
        </Solo>

        <!-- State Machine Driven by stateIndex -->
        <StateMachine name="MascotStateMachine" id="0:70">
            <StateMachineNumber name="stateIndex" id="0:80"/>

            <StateMachineLayer name="MascotLayer" id="0:71">
                <AnyState x="0" y="0">
                    <StateTransition stateToId="0:30">
                        <TransitionNumberCondition inputId="0:80" opValue="equal" value="0"/>
                    </StateTransition>
                    <StateTransition stateToId="0:31">
                        <TransitionNumberCondition inputId="0:80" opValue="equal" value="1"/>
                    </StateTransition>
                    <StateTransition stateToId="0:32">
